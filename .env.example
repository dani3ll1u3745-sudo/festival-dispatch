# Copy this file to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=
# Your ngrok static domain, e.g. https://your-name.ngrok-free.app (used for the QR code)
PUBLIC_URL=
PORT=3000
# Voice clips are transcribed on this machine with the open-source Whisper model (no key needed;
# the model downloads once, about 500 MB; WHISPER_MODEL=Xenova/whisper-base.en is faster and smaller but less accurate). Set LOCAL_TRANSCRIPTION=off to let phones transcribe instead.
# Optional: use a hosted service instead by setting ONE of these.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
