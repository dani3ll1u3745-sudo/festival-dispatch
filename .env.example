# Copy this file to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=
# Your ngrok static domain, e.g. https://your-name.ngrok-free.app (used for the QR code)
PUBLIC_URL=
PORT=3000
# Optional: transcribe volunteers' voice clips on the server (Claude can't take audio).
# Set ONE of these. OpenAI is used if both are set.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
